// Waybar config 
{
    "layer": "top",
    "position": "top",
    "height": 32,
    "exclusive": true,
    "passthrough": false,
    "gtk-layer-shell": true,
    "fixed-center": true,
    "margin-top": 8,
    "margin-left": 8,
    "margin-right": 8,

    "modules-left": [
        "custom/l_end", "clock", "custom/todoist", "custom/r_end"
    ],
    "modules-center": [
        "custom/l_end", "hyprland/workspaces", "custom/r_end"
    ],
    "modules-right": [
        "custom/l_end", "tray", "custom/r_end",
        "custom/l_end", "custom/shortcuts", "network", "bluetooth", "memory", "cpu", "battery", "custom/notification", "custom/controlcenter", "custom/r_end"
    ],

    // ---- Control Center (quickshell) ----
    "custom/controlcenter": {
        "format": "󰒓",
        "tooltip": "Control Center",
        "on-click": "/usr/bin/quickshell ipc -p $HOME/.config/quickshell-controlcenter call controlcenter open"
    },

    // ---- Workspaces ----
    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "active": "\u25CF",
            "default": "\u25CB",
            "empty": "\u25CB",
            "urgent": "\u25CE"
        },
        "disable-scroll": true,
        "all-outputs": false,
        "active-only": false,
        "show-special": false,
        "on-click": "activate"
    },

    // ---- Clock ----
    "clock": {
        "format": "{:%H.%M | %b %d, %Y}",
        "tooltip": false,
        "on-click": "bash -lc /home/abay/.config/hyprdots/scripts/calendar-panel.py",
        "on-click-right": "bash -lc /home/abay/.config/hyprdots/scripts/calendar-panel.py"
    },

    // ---- Updates (Debian) ----
    "custom/updates": {
        "exec": "$HOME/.config/hyprdots/scripts/systemupdate.sh",
        "return-type": "json",
        "format": "󰆦 {}",
        "on-click": "$HOME/.config/hyprdots/scripts/systemupdate.sh up",
        "interval": 3600,
        "tooltip": true
    },

    // ---- Shortcut cheatsheet ----
    "custom/shortcuts": {
        "format": "󰌌",
        "interval": "once",
        "tooltip": "Hyprland keybinds (click)",
        "on-click": "bash -lc /home/abay/.config/hyprdots/scripts/shortcuts-panel.py"
    },

    // ---- Notification bell (opens Control Center at the notification list) ----
    "custom/notification": {
        "format": "󰂚",
        "tooltip": "Notifications",
        "on-click": "/usr/bin/quickshell ipc -p $HOME/.config/quickshell-controlcenter call controlcenter toggleNotifications"
    },

    // ---- Todoist tasks (rotating) ----
    "custom/todoist": {
        "exec": "$HOME/.config/hyprdots/scripts/todoist-tasks.py",
        "return-type": "json",
        "format": "| {}",
        "tooltip": true,
        "on-click": "bash -lc '$HOME/apps/todoist.AppImage >/dev/null 2>&1 &'"
    },

    // ---- Tray ----
    "tray": {
        "icon-size": 16,
        "spacing": 8
    },

    // ---- Network ----
    "network": {
        "interface": "wlo1",
        "tooltip": true,
        "on-click": "/usr/bin/quickshell ipc -p $HOME/.config/quickshell-controlcenter call network toggle",
        "on-click-right": "nm-connection-editor",
        "format-wifi": "󰖩",
        "format-ethernet": "󰈀",
        "format-linked": "󰈀 {ifname}",
        "format-disconnected": "󰖪",
        "tooltip-format": "Network: {essid}\nSignal: {signaldBm}dBm ({signalStrength}%)\nInterface: {ifname}\nIP: {ipaddr}/{cidr}",
        "interval": 2
    },

    // ---- Bluetooth ----
    "bluetooth": {
        "format": "",
        "on-click": "/usr/bin/quickshell ipc -p $HOME/.config/quickshell-controlcenter call bluetooth toggle",
        "format-connected": "",
        "format-disabled": "",
        "format-off": "",
        "tooltip-format": "{controller_alias}",
        "tooltip-format-connected": "{controller_alias}\n{num_connections} device(s) connected\n\n{device_enumerate}"
    },

    // ---- Audio ----
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟",
        "on-click": "bash -lc /home/abay/.config/hyprdots/scripts/audio-panel.py",
        "on-click-middle": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +5%",
        "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -5%",
        "tooltip-format": "{icon} {desc} — {volume}%\nclick: audio panel · scroll: volume",
        "scroll-step": 5,
        "format-icons": {
            "headphone": "󰋋",
            "hands-free": "󰋎",
            "headset": "󰋎",
            "phone": "󰏲",
            "portable": "󰏲",
            "car": "󰄋",
            "default": ["󰕿", "󰖀", "󰕾"]
        }
    },

    // ---- CPU ----
    "cpu": {
        "interval": 10,
        "format": "󰻠 {usage}%",
        "tooltip": true
    },

    // ---- Memory ----
    "memory": {
        "interval": 30,
        "format": "󰘚 {used:0.1f}G",
        "format-m": "󰘚 {used:0.1f}G",
        "format-h": "󰘚 {used:0.1f}G",
        "format-c": "󰘚 {used:0.1f}G",
        "tooltip": true,
        "tooltip-format": "󰾆 {percentage}%\n󰍛 {used:0.1f}GB / {total:0.1f}GB"
    },

    // ---- Battery ----
    "battery": {
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰂄 {capacity}%",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    },

    // ---- Backlight ----
    "backlight": {
        "format": "{icon} {percent}%",
        "format-icons": ["󰃝", "󰃞", "󰖨"],
        "on-click": "bash -lc /home/abay/.config/hyprdots/scripts/brightness-panel.py",
        "on-scroll-up": "brightnessctl -d intel_backlight set 5%+",
        "on-scroll-down": "brightnessctl -d intel_backlight set 5%-",
        "tooltip": true,
        "tooltip-format": "Brightness {percent}%\nclick: panel · scroll: ±5%",
        "min-length": 6
    },

    // ---- Idle inhibitor ----
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "󰥔",
            "deactivated": "󰒲"
        }
    },

    // ---- Padding modules (trik bikin pill terpisah) ----
    "custom/l_end": { "format": " ", "interval": "once", "tooltip": false },
    "custom/r_end": { "format": " ", "interval": "once", "tooltip": false },
    "custom/padd":  { "format": " ", "interval": "once", "tooltip": false }
}
