{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "/home/abay/.config/fastfetch/anya.png",
    "width": 30,
    "height": 20,
    "preserveAspectRatio": true,
    "padding": {
      "top": 0,
      "left": 0,
      "right": 3
    }
  },
  "display": {
    "separator": " ",
    "color": {
      "keys": "38;2;145;197;255",
      "title": "38;2;145;197;255"
    },
    "bar": {
      "width": 10,
      "char": {
        "elapsed": "━",
        "total": "─"
      },
      "border": {
        "left": "",
        "right": ""
      },
      "color": {
        "elapsed": "38;2;145;197;255",
        "total": "38;2;38;38;38",
        "border": "38;2;38;38;38"
      }
    },
    "size": {
      "spaceBeforeUnit": "never",
      "ndigits": 1
    }
  },
  "modules": [
    "title",
    {
      "type": "custom",
      "format": "\u001b[38;2;38;38;38m─────────────────────────────────────────────\u001b[0m"
    },
    {
      "type": "os",
      "key": "OS     ",
      "format": "{name} {version-id}"
    },
    {
      "type": "kernel",
      "key": "Kernel ",
      "format": "{release}"
    },
    {
      "type": "wm",
      "key": "WM     ",
      "format": "{pretty-name} {version}"
    },
    {
      "type": "terminal",
      "key": "Term   ",
      "format": "{pretty-name}"
    },
    {
      "type": "shell",
      "key": "Shell  ",
      "format": "{pretty-name}"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;38;38;38m─────────────────────────────────────────────\u001b[0m"
    },
    {
      "type": "host",
      "key": "Device ",
      "format": "{name}"
    },
    {
      "type": "cpu",
      "key": "CPU    ",
      "format": "{name} ({cores-logical}c)",
      "temp": false
    },
    {
      "type": "gpu",
      "key": "GPU    ",
      "format": "{name} · {type}",
      "temp": false
    },
    {
      "type": "memory",
      "key": "RAM    ",
      "format": "{percentage-bar}  {used} / {total}",
      "percent": {
        "type": 2
      }
    },
    {
      "type": "swap",
      "key": "Swap   ",
      "format": "{percentage-bar}  {used} / {total}",
      "percent": {
        "type": 2
      }
    },
    {
      "type": "disk",
      "key": "Disk   ",
      "folders": "/",
      "format": "{size-percentage-bar}  {size-used} / {size-total}",
      "percent": {
        "type": 2
      }
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;38;38;38m─────────────────────────────────────────────\u001b[0m"
    },
    {
      "type": "uptime",
      "key": "Uptime ",
      "format": "{days}d {hours}h {minutes}m"
    },
    {
      "type": "display",
      "key": "Display",
      "format": "{width}x{height} @ {refresh-rate} · {name}"
    },
    {
      "type": "battery",
      "key": "Batt   ",
      "format": "{capacity} · {status}"
    },
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 0
    }
  ]
}
