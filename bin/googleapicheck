    ("Places Autocomplete",
     "https://maps.googleapis.com/maps/api/place/autocomplete/json?input=bing&types=(cities)&key={key}", "GET", None, False),
    ("Places Details",
     "https://maps.googleapis.com/maps/api/place/details/json?place_id=ChIJN1t_tDeuEmsRUsoyG83frY4&fields=name&key={key}", "GET", None, False),
    ("Roads Snap to Roads",
     "https://roads.googleapis.com/v1/snapToRoads?path=-35.278,149.129|-35.280,149.129&interpolate=true&key={key}", "GET", None, False),
    ("Roads Nearest Roads",
     "https://roads.googleapis.com/v1/nearestRoads?points=60.170,24.942|60.171,24.943&key={key}", "GET", None, False),
    ("Roads Speed Limits",
     "https://roads.googleapis.com/v1/speedLimits?path=38.758,-9.037&key={key}", "GET", None, False),
    ("Geolocation",
     "https://www.googleapis.com/geolocation/v1/geolocate?key={key}", "POST", '{"considerIp": true}', False),
    ("Translate v2",
     "https://translation.googleapis.com/language/translate/v2?q=hello&target=id&key={key}", "GET", None, False),
    ("Generative Language (Gemini)",
     "https://generativelanguage.googleapis.com/v1beta/models?key={key}", "GET", None, False),
    ("YouTube Data v3",
     "https://www.googleapis.com/youtube/v3/search?part=snippet&q=test&maxResults=1&key={key}", "GET", None, False),
    ("Drive v3 (public files)",
     "https://www.googleapis.com/drive/v3/files?pageSize=1&key={key}", "GET", None, False),
    ("Sheets v4 (public sheet)",
     "https://sheets.googleapis.com/v4/spreadsheets/1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms?fields=sheets.properties.title&key={key}", "GET", None, False),
    ("Custom Search JSON",
     "https://www.googleapis.com/customsearch/v1?q=test&key={key}", "GET", None, False),
    ("Identity Toolkit (Firebase)",
     "https://identitytoolkit.googleapis.com/v1/accounts:signUp?key={key}", "POST", "{}", False),
]

REASONS = {
    "keyInvalid": "key invalid/deleted",
    "API_KEY_SERVICE_BLOCKED": "key blocked by Google",
    "API_KEY_INVALID": "key invalid",
    "SERVICE_DISABLED": "key VALID, API disabled",
    "PERMISSION_DENIED": "key restricted (referrer/IP/API)",
    "refererBlocked": "key restricted by HTTP referrer",
    "ipRefererBlocked": "key restricted by IP/referrer",
    "REQUEST_DENIED": "request denied",
    "QUOTA_EXCEEDED": "key VALID, quota exceeded",
    "rateLimitExceeded": "key VALID, rate limited",
    "dailyLimitExceeded": "key VALID, daily limit exceeded",
    "usageLimits": "key VALID, usage limit hit",
    "badKey": "bad key",
}


def clean_msg(s, limit=90):
    # strip "Learn more" / console links, collapse whitespace, truncate
    for sep in ("Learn more:", "learn more:", "Enable it by visiting"):
        if sep in s:
            s = s.split(sep)[0].rstrip()
    return " ".join(s.split())[:limit]


def slug(name):
    # "Maps Geocoding" -> "maps-geocoding", "Drive v3 (public files)" -> "drive-v3"
    import re
    s = name.split("(")[0].strip().lower()
    s = re.sub(r"[^a-z0-9]+", "-", s)
    return s.strip("-")


def human_status(flag, detail):
    # sqlmap-style short status
    if flag == "VULN":
        return "Valid"
    if flag == "INVALID":
        return "Invalid"
    if flag == "VALID":
        # valid key tapi API restricted/disabled -> ga bisa dieksploit
        return "not vuln"
    if flag == "DENIED":
        return "Denied"
    if flag == "ERR":
        return "Error"
    return "not vuln"


def classify(name, url, method, body, is_binary, key):
    full_url = url.replace("{key}", key)
    data = body.encode() if body else None
    headers = {"User-Agent": UA, "Content-Type": "application/json"}
    req = urllib.request.Request(full_url, data=data, headers=headers, method=method)
    try:
        with urllib.request.urlopen(req, timeout=15) as r:
            code = r.getcode()
            raw = r.read()
            if is_binary:
                ok = code == 200 and len(raw) > 1000  # image payload
                return name, "VULN" if ok else f"HTTP {code}", f"200 OK, {len(raw)} bytes", full_url
            try:
                j = json.loads(raw)
            except Exception:
                return name, "VULN" if code == 200 else f"HTTP {code}", "200 OK", full_url
            # 200 but JSON may carry status field (maps legacy)
            st = j.get("status", "")
            if st == "OK":
                return name, "VULN", "200 OK", full_url
            if st:  # REQUEST_DENIED etc.
                msg = j.get("error_message", st)
                return name, "DENIED", clean_msg(f"{st} - {msg}"), full_url
            return name, "VULN", "200 OK", full_url
    except urllib.error.HTTPError as e:
        raw = e.read()
        try:
            j = json.loads(raw)
            err = j.get("error", {})
            status = err.get("status", "")
            reason = ""
            for fe in err.get("errors", []) or []:
                reason = fe.get("reason", "")
                break
            label = REASONS.get(reason) or REASONS.get(status) or status or f"HTTP {e.code}"
            detail = clean_msg(err.get("message", ""))
            if "API key not valid" in detail or "keyInvalid" in (reason, status):
                flag, label = "INVALID", "key invalid"
            elif reason == "SERVICE_DISABLED" or "has not been used" in detail or "not been enabled" in detail:
                flag = "VALID"  # key itself works, API just disabled
            elif "PERMISSION_DENIED" in status or reason in ("ipRefererBlocked", "refererBlocked"):
                flag = "VALID"  # valid but restricted
            elif "VALID" in label:
                flag = "VALID"
            else:
                flag = "DENIED"
            return name, flag, f"[{reason or status}] {label} - {detail}", full_url
        except Exception:
            return name, f"HTTP {e.code}", raw[:120].decode("utf-8", "replace"), full_url
    except Exception as e:
        return name, "ERR", str(e)[:120], full_url


def ts():
    return time.strftime("%H:%M:%S")


def day():
    return time.strftime("%Y-%m-%d")


def log(level, msg, color=""):
    C = "\033[0m" if color else ""
    print(f"{color}[{ts()}] [{level}]{C} {msg}", flush=True)


def check_key(key):
    masked = key[:8] + "*" * (len(key) - 12) + key[-4:]

    C = "\033[0m"
    G = "\033[92m"   # green  - valid/vuln
    Y = "\033[93m"   # yellow - denied
    R = "\033[91m"   # red    - invalid/error
    D = "\033[90m"   # dim    - not vuln
    B = "\033[1m"    # bold

    counts = {"Valid": 0, "not vuln": 0, "Denied": 0, "Invalid": 0, "Error": 0}

    print()
    print(f"{B}[*] starting @ {ts()} /{day()}/{C}\n")
    log("INFO", f"key {B}{masked}{C}  ({len(key)} chars, {len(ENDPOINTS)} endpoints)")

    for ep in ENDPOINTS:
        name = ep[0]
        slug_name = slug(name)
        log("INFO", f"testing '{slug_name}'")
        _name, flag, detail, url = classify(*ep, key)
        status = human_status(flag, detail)
        counts[status] = counts.get(status, 0) + 1
        if status == "Valid":
            log("VULN", f"'{slug_name}' is vulnerable", G)
            print(f"       {D}{url}{C}", flush=True)
        elif status == "Denied":
            log("WARNING", f"'{slug_name}' denied ({detail})", Y)
        elif status == "Invalid":
            log("CRITICAL", f"'{slug_name}' key invalid", R)
        elif status == "Error":
            log("ERROR", f"'{slug_name}' {detail}", R)
        else:
            log("INFO", f"'{slug_name}' not vulnerable", D)

    print()
    parts = []
    if counts["Valid"]:
        parts.append(f"{G}{counts['Valid']} valid{C}")
    for k in ("not vuln", "Denied", "Invalid", "Error"):
        if counts[k]:
            parts.append(f"{D}{counts[k]} {k}{C}" if k == "not vuln" else f"{Y}{counts[k]} {k}{C}")
    log("WARNING", f"{len(ENDPOINTS)} checked - " + ", ".join(parts), Y)

    print()
    print(f"{B}[*] ending @ {ts()} /{day()}/{C}\n")


def main():
    ap = argparse.ArgumentParser(description="Google API Key Checker")
    ap.add_argument("key", nargs="?", help="API key AIza...")
    ap.add_argument("-f", "--file", help="file with keys, one per line")
    args = ap.parse_args()

    keys = []
    if args.key:
        keys.append(args.key.strip())
    if args.file:
        with open(args.file) as fh:
            keys += [l.strip() for l in fh if l.strip().startswith("AIza")]
    if not keys:
        ap.print_help()
        sys.exit(1)

    for k in keys:
        if not k.startswith("AIza"):
            print(f"[-] skip, bukan format API key: {k[:20]}")
            continue
        check_key(k)


if __name__ == "__main__":
    main()
