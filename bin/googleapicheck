#!/usr/bin/env python3
"""Google API Key Checker
usage:
  googleapicheck <API_KEY>
  googleapicheck -f keys.txt
"""
import argparse
import json
import sys
import time
import urllib.request
import urllib.error
from concurrent.futures import ThreadPoolExecutor

UA = "Mozilla/5.0 (X11; Linux x86_64) googleapicheck/2.0"

# (name, url template with {key}, http method, body or None, binary response?)
ENDPOINTS = [
    ("Maps Geocoding",
     "https://maps.googleapis.com/maps/api/geocode/json?address=jakarta&key={key}", "GET", None, False),
    ("Maps Static Map",
     "https://maps.googleapis.com/maps/api/staticmap?center=-6.2,106.8&zoom=12&size=400x400&key={key}", "GET", None, True),
    ("Maps Street View",
     "https://maps.googleapis.com/maps/api/streetview?location=-6.2,106.8&size=400x400&key={key}", "GET", None, True),
    ("Maps Directions",
